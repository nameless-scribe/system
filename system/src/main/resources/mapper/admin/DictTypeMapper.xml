<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.system.admin.mapper.DictTypeMapper">

    <resultMap id="DictTypeResultMap" type="com.system.admin.entity.DictType">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <select id="selectAll" resultMap="DictTypeResultMap">
        select id, code, name, status, remark
        from sys_dict_type
        order by id desc
    </select>

    <select id="selectByCode" parameterType="string" resultMap="DictTypeResultMap">
        select id, code, name, status, remark
        from sys_dict_type
        where code = #{code}
    </select>

    <insert id="insert" parameterType="com.system.admin.entity.DictType">
        insert into sys_dict_type(code, name, status, remark)
        values (#{code}, #{name}, #{status}, #{remark})
    </insert>

    <update id="update" parameterType="com.system.admin.entity.DictType">
        update sys_dict_type
        set code   = #{code},
            name   = #{name},
            status = #{status},
            remark = #{remark}
        where id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        delete from sys_dict_type where id = #{id}
    </delete>

</mapper>

