<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.system.audit.mapper.AuditLogMapper">

    <resultMap id="AuditLogResultMap" type="com.system.audit.entity.AuditLog">
        <id property="id" column="id"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operatorName" column="operator_name"/>
        <result property="operatorRole" column="operator_role"/>
        <result property="ip" column="ip"/>
        <result property="httpMethod" column="http_method"/>
        <result property="uri" column="uri"/>
        <result property="queryString" column="query_string"/>
        <result property="requestBody" column="request_body"/>
        <result property="success" column="success"/>
        <result property="resultCode" column="result_code"/>
        <result property="errorMessage" column="error_message"/>
        <result property="costMs" column="cost_ms"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insert" parameterType="com.system.audit.entity.AuditLog">
        insert into sys_audit_log(
            id, operator_id, operator_name, operator_role, ip,
            http_method, uri, query_string, request_body,
            success, result_code, error_message, cost_ms
        ) values (
            #{id}, #{operatorId}, #{operatorName}, #{operatorRole}, #{ip},
            #{httpMethod}, #{uri}, #{queryString}, #{requestBody},
            #{success}, #{resultCode}, #{errorMessage}, #{costMs}
        )
    </insert>

    <select id="selectById" resultMap="AuditLogResultMap">
        select *
        from sys_audit_log
        where id = #{id}
    </select>

    <sql id="Where">
        <where>
            <if test="operatorName != null and operatorName != ''">
                and operator_name like concat('%', #{operatorName}, '%')
            </if>
            <if test="uri != null and uri != ''">
                and uri like concat('%', #{uri}, '%')
            </if>
            <if test="success != null">
                and success = #{success}
            </if>
            <if test="startTime != null">
                and create_time &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                and create_time &lt;= #{endTime}
            </if>
        </where>
    </sql>

    <select id="selectPage" resultMap="AuditLogResultMap">
        select *
        from sys_audit_log
        <include refid="Where"/>
        order by create_time desc
        limit #{start}, #{size}
    </select>

    <select id="count" resultType="int">
        select count(1)
        from sys_audit_log
        <include refid="Where"/>
    </select>

</mapper>

