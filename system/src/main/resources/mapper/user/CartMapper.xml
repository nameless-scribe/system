<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.system.user.mapper.CartMapper">

    <resultMap id="CartItemResultMap" type="com.system.user.entity.CartItem">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="goodsId" column="goods_id"/>
        <result property="quantity" column="quantity"/>
    </resultMap>

    <select id="selectByUserId" resultMap="CartItemResultMap">
        select * from cart_item where user_id = #{userId}
    </select>

    <insert id="insert" parameterType="com.system.user.entity.CartItem">
        insert into cart_item(user_id, goods_id, quantity)
        values (#{userId}, #{goodsId}, #{quantity})
    </insert>

    <update id="update" parameterType="com.system.user.entity.CartItem">
        update cart_item
        set user_id  = #{userId},
            goods_id = #{goodsId},
            quantity = #{quantity}
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from cart_item where id = #{id}
    </delete>

    <delete id="deleteByUserId">
        delete from cart_item where user_id = #{userId}
    </delete>

    <select id="selectByUserAndGoods" resultMap="CartItemResultMap">
        select id, user_id, goods_id, quantity
        from cart_item
        where user_id = #{userId}
          and goods_id = #{goodsId}
        limit 1
    </select>

    <update id="increaseQuantity">
        update cart_item
        set quantity = quantity + #{delta}
        where id = #{id}
    </update>

    <select id="selectByIds" resultMap="CartItemResultMap">
        select id, user_id, goods_id, quantity
        from cart_item
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>

